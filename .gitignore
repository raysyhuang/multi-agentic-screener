# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/

# Virtual environment
.venv/
venv/

# Environment variables (contains API keys!)
.env

# Database
*.db
*.sqlite3
data_cache.sqlite

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# pytest
.pytest_cache/
.coverage
htmlcov/

# Claude Code
.claude/

# Screenshots & temp images
*.png
# ...but the dashboard's PWA icons are SHIPPED ASSETS, not screenshots. The
# blanket rule above silently dropped all four from `git add dashboard/`, so the
# deployed manifest referenced icons that 404'd and the iOS home-screen install
# fell back to a generic glyph. Un-ignore them explicitly.
!dashboard/icons/*.png

# Backtest result cache
backtest_results/

# One-off utility scripts (not part of pipeline)
scripts/query_trades.py
scripts/telegram_remote_cli.py
scripts/test_bot_one_off.py

# OHLCV data cache (parquet files, regenerated on demand)
data/cache/

# SQLite WAL/SHM
*.sqlite-wal
*.sqlite-shm

# Debug outputs
outputs/
dashboard/data.json

# Local agent/tool scratch dirs (Playwright MCP traces, editor agents)
.playwright-mcp/
.agents/
.continue/
.trae/

# macOS/cloud-sync duplicate copies ("foo 2.py", "foo 3.py"). Never source —
# they are byte-identical strays that Python cannot even import, and a careless
# `git add -A` sweeps them into a PR (caught in review on #64).
*[ ][0-9].py
*[ ][0-9].json

# Local-only trees. These are working artifacts, not repo content, and a
# careless `git add -A` has swept them into a PR under review — the second time
# putting trade-level P&L into public history. scripts/hooks/pre-commit is the
# mechanical guard; this list is the first line.
backups/
deploy/
skills-lock.json

# Credentials and database dumps — never, under any circumstances.
*.dump
*.sql
*.sql.gz
*.pem
*.key
*.p12
